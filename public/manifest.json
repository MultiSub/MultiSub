{
  "manifest_version": 3,
  "name": "MultiSub: Official Translation Tracks for HBO Max",
  "description": "Watch HBO Max with two official subtitle tracks at once. Choose languages, placement, and matched styling.",
  "version": "0.1.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "MultiSub: Official Translation Tracks for HBO Max",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://play.hbomax.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://play.hbomax.com/*"]
    }
  ]
}
